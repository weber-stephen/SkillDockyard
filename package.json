{
  "name": "skill-dockyard",
  "version": "0.2.0",
  "private": false,
  "description": "Shared skill library for teams preserving AI skill improvements.",
  "bin": {
    "skill-dockyard": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pages": "npm run build && tsx scripts/smoke-pages.ts",
    "typecheck": "tsc --noEmit",
    "cli:build": "tsup \"src/cli/index.ts\" \"src/cli/commands/**/*.ts\" --format cjs --target node22 --out-dir dist --clean",
    "cli": "npm run cli:build --silent && node bin/run.js",
    "prepare": "npm run cli:build"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.1",
    "@oclif/core": "^4.11.14",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^11.4.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.110.2",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^5.4.2",
    "lucide-react": "^0.562.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.4.0",
    "tinyglobby": "^0.2.17",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "oclif": {
    "bin": "skill-dockyard",
    "commands": "./dist/commands",
    "topicSeparator": " "
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "browserslist": "4.29.3",
    "@oclif/core": {
      "brace-expansion": "5.0.12"
    },
    "filelist": {
      "brace-expansion": "2.1.7"
    },
    "next": {
      "baseline-browser-mapping": "2.11.27"
    }
  }
}
